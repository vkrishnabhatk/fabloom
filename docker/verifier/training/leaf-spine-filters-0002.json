 "configs": {
  "spine1": "hostname spine1\nservice routing protocols model multi-agent\nip routing\n!\nip access-list FABLOOM-PROTECT\n   10 deny tcp any any eq 23\n   20 permit ip any any\n!\ninterface Loopback0\n   ip address 10.0.0.1/32\n!\ninterface Ethernet1\n   no switchport\n   ip address 10.1.0.0/31\n   ip access-group FABLOOM-PROTECT in\n!\ninterface Ethernet2\n   no switchport\n   ip address 10.1.0.16/31\n   ip access-group FABLOOM-PROTECT in\n!\nrouter bgp 65000\n   router-id 10.0.0.1\n   neighbor 10.1.0.1 remote-as 65101\n   neighbor 10.1.0.17 remote-as 65102\n   network 10.0.0.1/32\n!\n",
  "spine2": "hostname spine2\nservice routing protocols model multi-agent\nip routing\n!\nip access-list FABLOOM-PROTECT\n   10 deny tcp any any eq 23\n   20 permit ip any any\n!\ninterface Loopback0\n   ip address 10.0.0.2/32\n!\ninterface Ethernet1\n   no switchport\n   ip address 10.1.0.2/31\n   ip access-group FABLOOM-PROTECT in\n!\ninterface Ethernet2\n   no switchport\n   ip address 10.1.0.18/31\n   ip access-group FABLOOM-PROTECT in\n!\nrouter bgp 65000\n   router-id 10.0.0.2\n   neighbor 10.1.0.3 remote-as 65101\n   neighbor 10.1.0.19 remote-as 65102\n   network 10.0.0.2/32\n!\n",
  "leaf1": "hostname leaf1\nservice routing protocols model multi-agent\nip routing\n!\nip access-list FABLOOM-PROTECT\n   10 deny tcp any any eq 23\n   20 permit ip any any\n!\ninterface Loopback0\n   ip address 10.0.1.1/32\n!\ninterface Ethernet1\n   no switchport\n   ip address 10.1.0.1/31\n   ip access-group FABLOOM-PROTECT in\n!\ninterface Ethernet2\n   no switchport\n   ip address 10.1.0.3/31\n   ip access-group FABLOOM-PROTECT in\n!\nrouter bgp 65101\n   router-id 10.0.1.1\n   neighbor 10.1.0.0 remote-as 65000\n   neighbor 10.1.0.2 remote-as 65000\n   network 10.0.1.1/32\n!\n",
  "leaf2": "hostname leaf2\nservice routing protocols model multi-agent\nip routing\n!\nip access-list FABLOOM-PROTECT\n   10 deny tcp any any eq 23\n   20 permit ip any any\n!\ninterface Loopback0\n   ip address 10.0.1.2/32\n!\ninterface Ethernet1\n   no switchport\n   ip address 10.1.0.17/31\n   ip access-group FABLOOM-PROTECT in\n!\ninterface Ethernet2\n   no switchport\n   ip address 10.1.0.19/31\n   ip access-group FABLOOM-PROTECT in\n!\nrouter bgp 65102\n   router-id 10.0.1.2\n   neighbor 10.1.0.16 remote-as 65000\n   neighbor 10.1.0.18 remote-as 65000\n   network 10.0.1.2/32\n!\n"
 },
