# Copy to .env for local use. Never commit .env.

# Required for model runs: generate, doctor, bench run and a live web demo.
FABLOOM_TOKEN_FACTORY_API_KEY=
# Optional: vendor documentation links on results (Tavily); without it they are skipped.
FABLOOM_TAVILY_API_KEY=

FABLOOM_BATFISH_HOST=localhost
FABLOOM_RUNS_DIR=runs
FABLOOM_LOG_JSON=false

# docker compose only: the hostname(s) Caddy serves with TLS; defaults to localhost.
# FABLOOM_DOMAIN="example.org, www.example.org"
# Optional: the web demo's daily model spend cap in USD (default 0.40).
# FABLOOM_WEB_SPEND_CAP_USD=0.40
